      "items": [
        {
          "info": {
            "name": "Docusign Gets the custom document fields from an  existing envelope document.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.docusign.net/Management/v2/accounts/:accountId/envelopes/:envelopeId/documents/:documentId/fields",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The external account number (int) or account id GUID."
              },
              {
                "name": "documentId",
                "value": "",
                "type": "path",
                "description": "The ID of the document being accessed."
              },
              {
                "name": "envelopeId",
                "value": "",
                "type": "path",
                "description": "The envelope's GUID. Eg 93be49ab-afa0-4adf-933c-f752070d71ec "
              }
            ]
          },
          "docs": "Retrieves the custom document field information from an existing envelope document."
        },
