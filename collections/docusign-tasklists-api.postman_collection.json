        {
          "id": "051a95a9-533b-427b-8e47-5e6474d9cf0b",
          "name": "Docusign Applies a task list to a room.",
          "request": {
            "name": "Docusign Applies a task list to a room.",
            "description": {
              "content": "Applies a task list to a room, based on the `taskTemplateId` that you specify in the `taskList` request body.\n\n**Note:** You must first create a task list template in the console. You cannot create a task list template by using the API at this time. To get the `taskListTemplateId`, use the \tTaskListTemplates: GetTaskListTemplates method.\n\n## Permissions\n\nYou must have the `canApplyTaskList` permission set to **true.**",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "accounts",
                ":accountId",
                "rooms",
                ":roomId",
                "task_lists"
