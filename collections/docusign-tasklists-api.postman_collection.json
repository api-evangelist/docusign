      "item": [
        {
          "id": "4b7c5b5b-3111-4c6d-a017-b6baa9107a58",
          "name": "Docusign Gets task lists for a room.",
          "request": {
            "name": "Docusign Gets task lists for a room.",
            "description": {
              "content": "Returns the task lists associated with a room.\n\n## Permissions\n\nYou must either be a member of the room who has been added to one or more tasks, or have one of the following permissions set to **true:** \n\n- `canAddTasksToAnyTaskLists`\n- `canApplyTaskList`\n- `canRemoveAnyTaskList`\n- `canSubmitTaskList`\n- `canReviewTaskList`\n\n**Note:** If a room has multiple tasks lists, you only see the task lists that contain tasks to which you have been added.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "accounts",
                ":accountId",
                "rooms",
                ":roomId",
                "task_lists"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "roomId",
                  "description": "(Required) The ID of the room."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "accountId",
                  "description": "(Required) The globally unique identifier (GUID) for the account."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
