          "name": "Docusign Get a List of Billing Invoices",
          "request": {
            "name": "Docusign Get a List of Billing Invoices",
            "description": {
              "content": "Retrieves a list of invoices for the account. If the from date or to date queries are not specified, the response returns invoices for the last 365 days.\n\nPrivileges required: account administrator ",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "accounts",
                ":accountId",
                "billing_invoices"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from_date",
                  "value": "<string>",
                  "description": "Specifies the date/time of the earliest invoice in the account to retrieve."
                },
                {
                  "disabled": false,
                  "key": "to_date",
                  "value": "<string>",
                  "description": "Specifies the date/time of the latest invoice in the account to retrieve."
