            "params": [
              {
                "name": "formId",
                "value": "",
                "type": "path",
                "description": "The ID of the form."
              },
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The globally unique identifier (GUID) for the account."
              }
            ]
          },
          "docs": "Returns details about a specific form, such as the date it was created and last updated, the number of pages, the form owner, and other information."
