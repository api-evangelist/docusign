  "item": [
    {
      "id": "9d1704e2-d83c-45e0-8782-ce25be929cc5",
      "name": "RoomTemplates",
      "description": {
        "content": "You can use a room template to set the transaction side and task lists for rooms. For example, a broker can create a room template for agents to use. You can enable the room template for all regions and offices, or just for specific ones. You create room templates and the task templates that room templates use in the console.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e572bfb6-f520-4fce-9ae8-5994a05a4ef8",
          "name": "Docusign Gets room templates.",
          "request": {
            "name": "Docusign Gets room templates.",
            "description": {
              "content": "This method returns a list of room templates that the user can use to create a new room. The response includes company and region-level templates.\n\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "accounts",
                ":accountId",
                "room_templates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "officeId",
                  "value": "<integer>",
                  "description": "The ID of the office for which the user wants to create a room. When you pass in a value for this parameter, only room templates that are valid for that office appear in the results. For users who are not Admins, the default is the ID of the user's default office.\nHowever, you can specify a value if the user belongs to multiple offices.\n\nIf the user is an Admin, set the `forAdmin` search parameter to **true** instead and omit the `officeId` parameter. "
                },
                {
                  "disabled": false,
                  "key": "onlyAssignable",
                  "value": "false",
                  "description": "When **true,** returns only the roles that the current user can assign to someone else. The default value is **false.**"
                },
                {
                  "disabled": false,
                  "key": "onlyEnabled",
                  "value": "true",
                  "description": "When true, only returns room templates that are not disabled."
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "100",
                  "description": "The number of results. When this property is used as a request parameter specifying the number of results to return, the value must be a number between `1` and `100` (default)."
                },
                {
                  "disabled": false,
                  "key": "startPosition",
                  "value": "0",
                  "description": "The index position within the total result set from which to start returning values. The default value is `0`."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "accountId",
                  "description": "(Required) The globally unique identifier (GUID) for the account."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
