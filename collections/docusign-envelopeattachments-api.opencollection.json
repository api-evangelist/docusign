      "items": [
        {
          "info": {
            "name": "Docusign Returns a list of attachments associated with the specified envelope",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.docusign.net/Management/v2/accounts/:accountId/envelopes/:envelopeId/attachments",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The external account number (int) or account id GUID."
              },
              {
                "name": "envelopeId",
                "value": "",
                "type": "path",
                "description": "The envelope's GUID. Eg 93be49ab-afa0-4adf-933c-f752070d71ec "
              }
            ]
          },
          "docs": "Docusign Returns a list of attachments associated with the specified envelope"
        },
        {
          "info": {
            "name": "Docusign Add one or more attachments to a DRAFT or IN-PROCESS envelope.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.docusign.net/Management/v2/accounts/:accountId/envelopes/:envelopeId/attachments",
            "params": [
