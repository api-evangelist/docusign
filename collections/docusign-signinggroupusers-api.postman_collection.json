          "request": {
            "name": "Docusign Gets a list of members in a Signing Group.",
            "description": {
              "content": "Retrieves the list of members in the specified Signing Group.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "accounts",
                ":accountId",
                "signing_groups",
                ":signingGroupId",
                "users"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "accountId",
                  "description": "(Required) The external account number (int) or account id GUID."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "signingGroupId",
                  "description": "(Required) Optional. The ID of the [signing group](https://support.docusign.com/en/guides/ndse-user-guide-signing-groups).\n\n**Note**: When you send an envelope to a signing group, anyone in the group can open it and sign it with their own signature. For this reason, we recommend that you do not include non-signer recipients (such as carbon copy recipients) in the same signing group as signer recipients. However, you could create a second signing group for the non-signer recipients and change the default action of Needs to Sign to a different value, such as Receives a Copy. "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "GET",
            "auth": null
