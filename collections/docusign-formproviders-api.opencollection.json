              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "The total number of associations to be returned.\n"
              },
              {
                "name": "startPosition",
                "value": "",
                "type": "query",
                "description": "The starting position on the list.\n"
              },
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The globally unique identifier (GUID) for the account."
              }
            ]
          },
          "docs": "Gets all associations by provider.\n"
        }
      ]
    }
