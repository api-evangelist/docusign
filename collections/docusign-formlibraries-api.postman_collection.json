          "id": "108cd3ca-7f4f-489e-a370-7918752ebd1b",
          "name": "Docusign Gets form libraries.",
          "request": {
            "name": "Docusign Gets form libraries.",
            "description": {
              "content": "Returns a list of form libraries to which the current user has access.\n\n## Permissions\n\nAll users can use this method, but the results will differ based on whether the company has asked DocuSign to enable **RequireOfficeLibraryAssignments** functionality. If this functionality is enabled for the account, then the list is filtered based on the offices that the user is in and the libraries that are assigned to those offices. When **RequireOfficeLibraryAssignments**  is not enabled, the API returns all results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "accounts",
                ":accountId",
                "form_libraries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "count",
                  "value": "100",
                  "description": "The number of results to return. This value must be a number between `1` and `100` (default)."
                },
                {
                  "disabled": false,
                  "key": "startPosition",
                  "value": "0",
                  "description": "The starting zero-based index position of the results set. The default value is `0`."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "accountId",
                  "description": "(Required) The globally unique identifier (GUID) for the account."
                }
              ]
            },
