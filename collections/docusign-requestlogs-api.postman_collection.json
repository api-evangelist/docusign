  "item": [
    {
      "id": "4a55c8fa-90bc-4277-aa77-e10d88f9372b",
      "name": "RequestLogs",
      "description": {
        "content": "The RequestLogs resource provide methods that allow you to retrieve and delete the API request log files.\n\nThe log files contain the API requests associated with your integration. They can aid you in troubleshooting specific issues within an integration, or if DocuSign Support requests an API trace log. ",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2232831b-ddfa-4074-8f8b-ed58a44f9fea",
          "name": "Docusign Gets the API request logging log files.",
          "request": {
            "name": "Docusign Gets the API request logging log files.",
            "description": {
              "content": "Retrieves a list of log entries as a JSON or xml object or as a zip file containing the entries.\n\nIf the Accept header is set to application/zip, the response is a zip file containing individual text files, each representing an API request.\n\nIf the Accept header is set to `application/json` or `application/xml`, the response returns list of log entries in either JSON or XML. An example JSON response body is shown below. ",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "diagnostics",
                "request_logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "encoding",
                  "value": "<string>"
                }
              ],
              "variable": []
